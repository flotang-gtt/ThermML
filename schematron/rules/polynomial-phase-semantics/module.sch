<?xml version='1.0' encoding='utf-8'?>
<sch:pattern xmlns:sch="http://purl.oclc.org/dsdl/schematron" id="thermml-polynomial-phase-semantics">
  <sch:title>Single-sublattice polynomial semantics</sch:title>
  <sch:rule context="t:database//t:property[((normalize-space(@xsi:type) = 'PolynomialL' or substring-after(normalize-space(@xsi:type), ':') = 'PolynomialL') and namespace::*[name() = substring-before(normalize-space(../@xsi:type), ':')] = 'http://calphad.org/thermml/v0')]">
    <sch:assert id="VAL-ERR-POLYNOMIAL-PROPERTY-SCOPE" role="error" test="parent::t:interaction/parent::t:interactions/parent::t:phase[((normalize-space(@xsi:type) = 'SingleSublatticePolynomialPhaseType' or substring-after(normalize-space(@xsi:type), ':') = 'SingleSublatticePolynomialPhaseType') and namespace::*[name() = substring-before(normalize-space(../@xsi:type), ':')] = 'http://calphad.org/thermml/v0')]">PolynomialL is valid only on an interaction of a SingleSublatticePolynomialPhaseType phase.</sch:assert>
  </sch:rule>
  <sch:rule context="t:database//t:phase[((normalize-space(@xsi:type) = 'SingleSublatticePolynomialPhaseType' or substring-after(normalize-space(@xsi:type), ':') = 'SingleSublatticePolynomialPhaseType') and namespace::*[name() = substring-before(normalize-space(../@xsi:type), ':')] = 'http://calphad.org/thermml/v0')]">
    <sch:let name="names" value="normalize-space(t:structure/t:sublattices/t:site/@constituents)" />
    <sch:assert id="VAL-ERR-POLYNOMIAL-STRUCTURE-SPECIES-COUNT" role="error" test="string-length($names) - string-length(translate($names, ' ', '')) + number($names != '') = count(t:species/t:specie)">The single sublattice must list exactly as many tokens as there are declared species.</sch:assert>
    <sch:assert id="VAL-ERR-POLYNOMIAL-MAGNETIC-STRUCTURE" role="error" test="t:structure/t:magnetic or not(t:endmembers/t:endmember/t:property[((normalize-space(@xsi:type) = 'M' or substring-after(normalize-space(@xsi:type), ':') = 'M') and namespace::*[name() = substring-before(normalize-space(../@xsi:type), ':')] = 'http://calphad.org/thermml/v0') or ((normalize-space(@xsi:type) = 'TCL' or substring-after(normalize-space(@xsi:type), ':') = 'TCL') and namespace::*[name() = substring-before(normalize-space(../@xsi:type), ':')] = 'http://calphad.org/thermml/v0') or ((normalize-space(@xsi:type) = 'BML' or substring-after(normalize-space(@xsi:type), ':') = 'BML') and namespace::*[name() = substring-before(normalize-space(../@xsi:type), ':')] = 'http://calphad.org/thermml/v0')] | t:interactions/t:interaction/t:property[((normalize-space(@xsi:type) = 'M' or substring-after(normalize-space(@xsi:type), ':') = 'M') and namespace::*[name() = substring-before(normalize-space(../@xsi:type), ':')] = 'http://calphad.org/thermml/v0') or ((normalize-space(@xsi:type) = 'TCL' or substring-after(normalize-space(@xsi:type), ':') = 'TCL') and namespace::*[name() = substring-before(normalize-space(../@xsi:type), ':')] = 'http://calphad.org/thermml/v0') or ((normalize-space(@xsi:type) = 'BML' or substring-after(normalize-space(@xsi:type), ':') = 'BML') and namespace::*[name() = substring-before(normalize-space(../@xsi:type), ':')] = 'http://calphad.org/thermml/v0')])">Magnetic M, TCL and BML properties require an IHJ magnetic structure. An all-zero magnetic structure is valid.</sch:assert>
  </sch:rule>
  <sch:rule context="t:database//t:phase[((normalize-space(@xsi:type) = 'SingleSublatticePolynomialPhaseType' or substring-after(normalize-space(@xsi:type), ':') = 'SingleSublatticePolynomialPhaseType') and namespace::*[name() = substring-before(normalize-space(../@xsi:type), ':')] = 'http://calphad.org/thermml/v0')]/t:species/t:specie">
    <sch:let name="name" value="string(@name)" />
    <sch:let name="names" value="concat(' ', normalize-space(../../t:structure/t:sublattices/t:site/@constituents), ' ')" />
    <sch:let name="token" value="concat(' ', $name, ' ')" />
    <sch:assert id="VAL-ERR-POLYNOMIAL-STRUCTURE-SPECIES-MEMBERSHIP" role="error" test="contains($names, $token) and not(contains(concat(' ', substring-after($names, $token)), $token))">Each declared species must occur exactly once in the single sublattice token list.</sch:assert>
    <sch:assert id="VAL-ERR-POLYNOMIAL-ENDMEMBER-COVERAGE" role="error" test="count(../../t:endmembers/t:endmember[t:constituents/t:site/t:const/@species = $name]) = 1">Each polynomial species must have exactly one endmember.</sch:assert>
    <sch:assert id="VAL-ERR-POLYNOMIAL-SPECIES-COMPOSITION" role="error" test="normalize-space(@composition) != ''">Polynomial species require a nonempty composition, including any preprocessed stoichiometric scaling.</sch:assert>
  </sch:rule>
  <sch:rule context="t:database//t:phase[((normalize-space(@xsi:type) = 'SingleSublatticePolynomialPhaseType' or substring-after(normalize-space(@xsi:type), ':') = 'SingleSublatticePolynomialPhaseType') and namespace::*[name() = substring-before(normalize-space(../@xsi:type), ':')] = 'http://calphad.org/thermml/v0')]/t:endmembers/t:endmember">
    <sch:assert id="VAL-ERR-POLYNOMIAL-ENDMEMBER-NAME" role="error" test="@name = t:constituents/t:site/t:const/@species">A polynomial endmember name must match its constituent species name literally.</sch:assert>
  </sch:rule>
  <sch:rule context="t:database//t:phase[((normalize-space(@xsi:type) = 'SingleSublatticePolynomialPhaseType' or substring-after(normalize-space(@xsi:type), ':') = 'SingleSublatticePolynomialPhaseType') and namespace::*[name() = substring-before(normalize-space(../@xsi:type), ':')] = 'http://calphad.org/thermml/v0')]/t:endmembers/t:endmember/t:property">
    <sch:assert id="VAL-ERR-POLYNOMIAL-ENDMEMBER-PROPERTY" role="error" test="((normalize-space(@xsi:type) = 'G' or substring-after(normalize-space(@xsi:type), ':') = 'G') and namespace::*[name() = substring-before(normalize-space(../@xsi:type), ':')] = 'http://calphad.org/thermml/v0') or ((normalize-space(@xsi:type) = 'M' or substring-after(normalize-space(@xsi:type), ':') = 'M') and namespace::*[name() = substring-before(normalize-space(../@xsi:type), ':')] = 'http://calphad.org/thermml/v0') or ((normalize-space(@xsi:type) = 'MolarVolume' or substring-after(normalize-space(@xsi:type), ':') = 'MolarVolume') and namespace::*[name() = substring-before(normalize-space(../@xsi:type), ':')] = 'http://calphad.org/thermml/v0') or ((normalize-space(@xsi:type) = 'ThermalExpansion' or substring-after(normalize-space(@xsi:type), ':') = 'ThermalExpansion') and namespace::*[name() = substring-before(normalize-space(../@xsi:type), ':')] = 'http://calphad.org/thermml/v0') or ((normalize-space(@xsi:type) = 'Compressibility' or substring-after(normalize-space(@xsi:type), ':') = 'Compressibility') and namespace::*[name() = substring-before(normalize-space(../@xsi:type), ':')] = 'http://calphad.org/thermml/v0') or ((normalize-space(@xsi:type) = 'BulkModulusDerivative' or substring-after(normalize-space(@xsi:type), ':') = 'BulkModulusDerivative') and namespace::*[name() = substring-before(normalize-space(../@xsi:type), ':')] = 'http://calphad.org/thermml/v0')">Polynomial endmembers accept G, M and the existing physical-property types, not interaction or MQM properties.</sch:assert>
  </sch:rule>
  <sch:rule context="t:database//t:phase[((normalize-space(@xsi:type) = 'SingleSublatticePolynomialPhaseType' or substring-after(normalize-space(@xsi:type), ':') = 'SingleSublatticePolynomialPhaseType') and namespace::*[name() = substring-before(normalize-space(../@xsi:type), ':')] = 'http://calphad.org/thermml/v0')]/t:interactions/t:interaction">
    <sch:assert id="VAL-ERR-POLYNOMIAL-INTERACTION-ARITY" role="error" test="count(t:constituents/t:site) = 1 and count(t:constituents/t:site/t:const) &gt;= 2 and count(t:constituents/t:site/t:const) &lt;= 4">A polynomial-phase interaction must contain one site with two to four constituents.</sch:assert>
    <sch:assert id="VAL-ERR-POLYNOMIAL-INTERACTION-PROPERTY" role="error" test="t:property and not(t:property[not(((normalize-space(@xsi:type) = 'PolynomialL' or substring-after(normalize-space(@xsi:type), ':') = 'PolynomialL') and namespace::*[name() = substring-before(normalize-space(../@xsi:type), ':')] = 'http://calphad.org/thermml/v0') or ((normalize-space(@xsi:type) = 'TCL' or substring-after(normalize-space(@xsi:type), ':') = 'TCL') and namespace::*[name() = substring-before(normalize-space(../@xsi:type), ':')] = 'http://calphad.org/thermml/v0') or ((normalize-space(@xsi:type) = 'BML' or substring-after(normalize-space(@xsi:type), ':') = 'BML') and namespace::*[name() = substring-before(normalize-space(../@xsi:type), ':')] = 'http://calphad.org/thermml/v0'))])">Each polynomial-phase interaction requires at least one property, and accepts only PolynomialL, TCL or BML.</sch:assert>
  </sch:rule>
  <sch:rule context="t:database//t:phase[((normalize-space(@xsi:type) = 'SingleSublatticePolynomialPhaseType' or substring-after(normalize-space(@xsi:type), ':') = 'SingleSublatticePolynomialPhaseType') and namespace::*[name() = substring-before(normalize-space(../@xsi:type), ':')] = 'http://calphad.org/thermml/v0')]/t:interactions/t:interaction/t:constituents/t:site/t:const">
    <sch:let name="name" value="string(@species)" />
    <sch:assert id="VAL-ERR-POLYNOMIAL-INTERACTION-DISTINCT-SPECIES" role="error" test="not(preceding-sibling::t:const[@species = $name])">Interaction constituents must be distinct; their listed order defines the exponent positions.</sch:assert>
  </sch:rule>
  <sch:rule context="t:database//t:phase[((normalize-space(@xsi:type) = 'SingleSublatticePolynomialPhaseType' or substring-after(normalize-space(@xsi:type), ':') = 'SingleSublatticePolynomialPhaseType') and namespace::*[name() = substring-before(normalize-space(../@xsi:type), ':')] = 'http://calphad.org/thermml/v0')]/t:interactions/t:interaction/t:property[((normalize-space(@xsi:type) = 'PolynomialL' or substring-after(normalize-space(@xsi:type), ':') = 'PolynomialL') and namespace::*[name() = substring-before(normalize-space(../@xsi:type), ':')] = 'http://calphad.org/thermml/v0')]/t:expr">
    <sch:let name="arity" value="count(../../t:constituents/t:site/t:const)" />
    <sch:let name="phase-id" value="generate-id(ancestor::t:phase[1])" />
    <sch:let name="s1" value="string(../../t:constituents/t:site/t:const[1]/@species)" />
    <sch:let name="s2" value="string(../../t:constituents/t:site/t:const[2]/@species)" />
    <sch:let name="s3" value="string(../../t:constituents/t:site/t:const[3]/@species)" />
    <sch:let name="s4" value="string(../../t:constituents/t:site/t:const[4]/@species)" />
    <sch:let name="i" value="number(@i)" />
    <sch:let name="j" value="number(@j)" />
    <sch:let name="k" value="number(@k)" />
    <sch:let name="l" value="number(@l)" />
    <sch:let name="has-k" value="boolean(@k)" />
    <sch:let name="has-l" value="boolean(@l)" />
    <sch:assert id="VAL-ERR-POLYNOMIAL-EXPONENT-ARITY" role="error" test="@i and @j and (($arity = 2 and not(@k) and not(@l)) or ($arity = 3 and @k and not(@l)) or ($arity = 4 and @k and @l))">Polynomial exponents must match constituent arity: i,j; i,j,k; or i,j,k,l. Explicit zero powers are valid.</sch:assert>
    <sch:assert id="VAL-ERR-POLYNOMIAL-EXPRESSION-NONEMPTY" role="error" test="normalize-space(.) != ''">A polynomial coefficient expression must contain text; an explicit zero is valid.</sch:assert>
    <sch:assert id="VAL-ERR-POLYNOMIAL-DUPLICATE-TERM" role="error" test="not(preceding::t:expr[parent::t:property[((normalize-space(@xsi:type) = 'PolynomialL' or substring-after(normalize-space(@xsi:type), ':') = 'PolynomialL') and namespace::*[name() = substring-before(normalize-space(../@xsi:type), ':')] = 'http://calphad.org/thermml/v0')] and generate-id(ancestor::t:phase[1]) = $phase-id and count(../../t:constituents/t:site/t:const) = $arity and string(../../t:constituents/t:site/t:const[1]/@species) = $s1 and string(../../t:constituents/t:site/t:const[2]/@species) = $s2 and string(../../t:constituents/t:site/t:const[3]/@species) = $s3 and string(../../t:constituents/t:site/t:const[4]/@species) = $s4 and number(@i) = $i and number(@j) = $j and boolean(@k) = $has-k and boolean(@l) = $has-l and (not(@k) or number(@k) = $k) and (not(@l) or number(@l) = $l)])">Ordered constituent/exponent identities must be unique across all PolynomialL properties and interactions in a phase, regardless of interaction names or coefficient text.</sch:assert>
  </sch:rule>
  <sch:rule context="t:database//t:phase[((normalize-space(@xsi:type) = 'SingleSublatticePolynomialPhaseType' or substring-after(normalize-space(@xsi:type), ':') = 'SingleSublatticePolynomialPhaseType') and namespace::*[name() = substring-before(normalize-space(../@xsi:type), ':')] = 'http://calphad.org/thermml/v0')]/t:ternaryInterpolations/t:interpolation">
    <sch:assert id="VAL-ERR-POLYNOMIAL-INTERPOLATION-LABELS" role="error" test="count(t:constituents/t:site) = 1 and count(t:constituents/t:site/t:const) = 3 and count(t:constituents/t:site/t:const[@site = 'i']) = 1 and count(t:constituents/t:site/t:const[@site = 'j']) = 1 and count(t:constituents/t:site/t:const[@site = 'k']) = 1">Polynomial interpolation requires one site containing exactly one i, j and k locator, using the site attribute.</sch:assert>
  </sch:rule>
</sch:pattern>
