<?xml version="1.0" encoding="UTF-8"?>
<database xmlns="http://calphad.org/thermml/v0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <phases>
    <phase xsi:type="CEFPhaseType" name="FCC_A1" state="solid">
      <species>
        <!-- Different native names sharing composition remain valid, with a warning. -->
        <specie name="Fe" composition="Fe1"/>
        <specie name="Iron" composition="Fe1"/>
        <!-- Same composition and charge invite review without implying identical species. -->
        <specie name="O[2-]" composition="O1" charge="-2"/>
        <specie name="Oxide" composition="O1" charge="-2"/>
        <specie name="C" composition="C1"/>
      </species>
    </phase>
  </phases>
</database>
